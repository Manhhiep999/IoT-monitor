# true  = chạy với dữ liệu giả lập (không cần Backend/ESP8266)
# false = gọi Backend Nuxt.js thật qua /api và ws://<host>/realtime
VITE_USE_MOCK=true

# Địa chỉ Backend Nuxt.js (dùng cho proxy khi chạy `npm run dev`)
VITE_BACKEND_URL=http://localhost:3000

# Để trống = dùng cùng host với Frontend (qua proxy). Ví dụ: ws://192.168.1.10:3000/realtime
VITE_WS_URL=

# Sau bao nhiêu giây không nhận dữ liệu cảm biến thì coi là mất kết nối
VITE_OFFLINE_AFTER_SECONDS=30

# Sau bao nhiêu giây ESP8266 chưa xác nhận lệnh bật/tắt thì báo timeout
VITE_ACTION_TIMEOUT_SECONDS=10
