{
  "name": "iot-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Backend Nuxt.js (Nitro) cho hệ thống giám sát nhiệt độ, độ ẩm, ánh sáng phòng học dùng ESP8266",
  "scripts": {
    "dev": "nuxt dev --port 3000",
    "build": "nuxt build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "db:init": "node --env-file-if-exists=.env scripts/db-init.mjs",
    "db:sample": "node --env-file-if-exists=.env scripts/db-init.mjs --sample",
    "db:reset": "node --env-file-if-exists=.env scripts/db-init.mjs --reset --sample",
    "esp:sim": "node --env-file-if-exists=.env scripts/esp-simulator.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.16.1",
    "mysql2": "^3.24.6",
    "nuxt": "^4.6.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
