# ---------- MySQL ----------
NUXT_DB_HOST=127.0.0.1
NUXT_DB_PORT=3306
NUXT_DB_USER=root
NUXT_DB_PASSWORD=
NUXT_DB_DATABASE=iot_monitor
# Múi giờ phiên MySQL (NOW(), measured_at, created_at)
NUXT_DB_TIMEZONE=+07:00

# ---------- MQTT Broker (Mosquitto / HiveMQ / EMQX) ----------
NUXT_MQTT_URL=mqtt://127.0.0.1:8899
NUXT_MQTT_USERNAME=
NUXT_MQTT_PASSWORD=
NUXT_MQTT_CLIENT_ID=

# ---------- Xác thực ----------
NUXT_JWT_SECRET=doi-chuoi-bi-mat-nay-khi-trien-khai
NUXT_JWT_EXPIRES_IN=1d

# ---------- Nghiệp vụ ----------
# Quá số giây này ESP8266 chưa xác nhận lệnh -> status = fail (nên lớn hơn VITE_ACTION_TIMEOUT_SECONDS của Frontend)
NUXT_ACTION_TIMEOUT_SECONDS=15
# Origin được gọi API trực tiếp (khi không dùng Vite proxy)
NUXT_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
